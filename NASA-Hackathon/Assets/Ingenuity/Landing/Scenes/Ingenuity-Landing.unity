  m_Name: 
  m_EditorClassIdentifier: 
  beats:
  - title: Jezero Crater, February 2021
    text: I landed on Mars folded under Perseverance's belly. On April 3, 2021, the
      rover set me down on the crater floor and drove away.
    voice: {fileID: 0}
    waitForEvent: 1
    showWhileActive: {fileID: 0}
  - title: April 19, 2021
    text: Now it's your turn. Spin up my rotors and make the first powered, controlled
      flight on another planet.
    voice: {fileID: 0}
    waitForEvent: 1
    showWhileActive: {fileID: 0}
  - title: From 5 flights to 72
    text: I was built to try just five flights. After this one worked, I became Perseverance's
      aerial scout, flying ahead to map the way.
    voice: {fileID: 0}
    waitForEvent: 0
    showWhileActive: {fileID: 0}
  nextLabel: Next
  finishLabel: Continue
  hideButtonOnLastBeat: 0
