  m_Name: 
  m_EditorClassIdentifier: 
  chapter: 1
  nextSceneName: InSight-Legacy
  voiceCues:
  - id: arrival_intro
    heading: A stationary geophysics lander
    caption: InSight stayed in one place. Its robotic arm set science packages onto
      the Martian surface.
    audioClip: {fileID: 8300000, guid: d54deaf54720ad945a080c3b2c5b16f9, type: 3}
  - id: seis
    heading: "SEIS \u2014 Mars's pulse"
    caption: SEIS measured marsquakes and ground vibrations. Its readings helped
      reveal Mars's crust, mantle, and core.
    audioClip: {fileID: 8300000, guid: a5ac80a8e079f7e45bb5c905ff583b71, type: 3}
  - id: hp3
    heading: "HP\xB3 \u2014 heat from below"
    caption: HP3 was designed to hammer nearly five meters underground, but unexpected
      soil stopped it short.
    audioClip: {fileID: 8300000, guid: 28c13c33336a3644281b752b1a3e7627, type: 3}
  - id: rise
    heading: "RISE \u2014 Mars's wobble"
    caption: RISE tracked subtle changes in Mars's rotation using radio signals between
      Earth and the lander.
    audioClip: {fileID: 8300000, guid: e18a292afe764c54ab3a77fe5865f371, type: 3}
  - id: science_summary
    heading: Three clues to Mars's interior
    caption: Quakes, heat flow, and rotation offered three different clues about
      Mars's hidden interior.
    audioClip: {fileID: 8300000, guid: 592cab927f40cae479584dbad12e8172, type: 3}
