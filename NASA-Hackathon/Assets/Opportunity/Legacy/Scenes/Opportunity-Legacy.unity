--- !u!114 &934101315
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 934101314}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d8b9da2a7c6e2e40a9b6382b429bd7d3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  beats:
  - title: Why was I left behind?
    text: There was never a ticket home. Getting to Mars took a rocket. Leaving would
      have taken another one. Every kilogram was spent on science, so Mars was always
      where I would finish.
    voice: {fileID: 0}
    waitForEvent: 0
    showWhileActive: {fileID: 0}
  - title: Why did my mission end?
    text: 'In June 2018, a dust storm covered the whole planet and blocked the sunlight
      my solar panels needed. On June 10, 2018, I went quiet.


      Try to wake
      me up, the way my team did.'
    voice: {fileID: 0}
    waitForEvent: 1
    showWhileActive: {fileID: 608871225}
  - title: My team never gave up
    text: Over eight months they sent more than a thousand commands. The last ones
      went out on February 12, 2019. The next day, NASA declared my mission complete.
    voice: {fileID: 0}
    waitForEvent: 0
    showWhileActive: {fileID: 0}
  - title: Why remember me?
    text: 'I was built to last 90 days. I lasted almost 15 years. I drove 45.16 km
      and found signs of ancient water, like a pond or lake on Earth.


      On
      October 11, 2026, a rover named Perseverance passed my driving record. Every
      explorer that comes next starts from what I found.'
    voice: {fileID: 0}
    waitForEvent: 0
    showWhileActive: {fileID: 0}
  nextLabel: Next
  finishLabel: Return to Earth
  hideButtonOnLastBeat: 0
  onFinished:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 2052486109}
        m_TargetAssemblyTypeName: NasaHack.LoadNextScene, Assembly-CSharp
        m_MethodName: Load
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  nextKey: 13
  titleText: {fileID: 87141286}
  bodyText: {fileID: 507090903}
  nextButton: {fileID: 1946164126}
  buttonLabel: {fileID: 954544535}
